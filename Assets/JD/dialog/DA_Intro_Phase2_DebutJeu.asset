  lines:
  - speaker: 0
    sentence: Merci beaucoup.
  - speaker: 0
    sentence: "je suis tomb\xE9 en panne devant votre maison."
  - speaker: 0
    sentence: En plus il pleut des cordes dehors...
  - speaker: 0
